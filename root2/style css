* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    font-size: 16px;
    scroll-behavior: smooth;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: #333333; /* Dark charcoal */
    background-color: #FFF7E8; /* Cream */
}

h1, h2, h3 {
    font-weight: 700;
    color: #D88C9A; /* Rose */
    margin-bottom: 0.5em;
}

h1 { font-size: 2.5rem; letter-spacing: -0.5px; }
h2 { font-size: 2rem; }
h3 { font-size: 1.5rem; color: #6B4F3A; /* Warm brown */ }

p {
    margin-bottom: 1rem;
}

header {
    background-color: #F6C1CC; /* Blush pink */
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 3px solid #D88C9A;
}

nav ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
}

nav a {
    text-decoration: none;
    color: #6B4F3A;
    font-weight: 600;
    transition: color 0.3s ease;
}

nav a:hover {
    color: #D88C9A;
}

main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
}

/* Grid Layout for Products and Features */
.product-grid, .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2rem;
}

/* Flexbox for Forms */
.form-container {
    display: flex;
    flex-direction: column;
    max-width: 600px;
    margin: 0 auto;
}

.card, .feature-item {
    background-color: white;
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid #A8BFA0; /* Sage green */
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 12px rgba(0, 0, 0, 0.1);
}

button, .btn {
    background-color: #D88C9A;
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 5px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: bold;
    transition: background-color 0.3s ease;
}

button:hover, .btn:hover {
    background-color: #6B4F3A;
}

button:focus, .btn:focus {
    outline: 3px solid #A8BFA0;
}

input, select, textarea {
    width: 100%;
    padding: 0.75rem;
    margin-bottom: 1rem;
    border: 1px solid #A8BFA0;
    border-radius: 4px;
    font-family: inherit;
    font-size: 1rem;
}

input:focus, select:focus, textarea:focus {
    border-color: #D88C9A;
    outline: none;
}

/* Tablet Breakpoint */
@media screen and (max-width: 768px) {
    header {
        flex-direction: column;
        text-align: center;
        gap: 1rem;
    }

    nav ul {
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }

    .product-grid, .features-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    h1 { font-size: 2rem; }
}

/* Mobile Breakpoint */
@media screen and (max-width: 480px) {
    .product-grid, .features-grid {
        grid-template-columns: 1fr;
    }

    main {
        padding: 1rem;
    }

    h1 { font-size: 1.75rem; }
    h2 { font-size: 1.5rem; }
}

/* --- Form Validation Styling --- */
.error-msg {
    color: #d9534f;
    font-size: 0.85rem;
    margin-top: 5px;
    display: block;
}

.success-msg {
    color: #28a745;
    font-weight: bold;
    margin-top: 15px;
    padding: 10px;
    background-color: #e9f7ec;
    border-radius: 5px;
}

/* --- Search & Dynamic Grid Styling --- */
.search-container {
    margin: 20px 0;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.product-card {
    border: 1px solid #ddd;
    padding: 15px;
    text-align: center;
    border-radius: 8px;
    transition: transform 0.3s;
}

.product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.product-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 5px;
    cursor: pointer; /* Shows user they can click for lightbox */
}

/* --- Lightbox Modal Styling --- */
.lightbox {
    display: none; /* Hidden by default */
    position: fixed;
    z-index: 999;
    padding-top: 50px;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.9);
}

.lightbox-content {
    margin: auto;
    display: block;
    width: 80%;
    max-width: 700px;
    animation: zoomIn 0.3s;
}

.close-lightbox {
    position: absolute;
    top: 20px;
    right: 35px;
    color: #f1f1f1;
    font-size: 40px;
    font-weight: bold;
    cursor: pointer;
}

/* Lightbox Animation */
@keyframes zoomIn {
    from {transform: scale(0.1)} 
    to {transform: scale(1)}
}
